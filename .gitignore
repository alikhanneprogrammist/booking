# Секреты / окружение (никогда не коммитим; .env.example — можно)
**/.env
**/.env.*.local

# Зависимости и сборка (дублирует вложенные .gitignore, для надёжности)
**/node_modules/
**/.next/
**/out/
**/build/
*.tsbuildinfo

# Локальные настройки Claude Code
.claude/settings.local.json

# Рабочие файлы бухгалтерии с данными клиентов (импортируются скриптом, в репо не хранятся)
*.xlsx

# Исключение: эксели доставки — нужны на проде для scripts/import-delivery.ts
# и scripts/backfill-districts.ts
!Еженедельны*.xlsx
!Тепловая*.xlsx
!Недельны*.xlsx
# Исключение: табель — нужен на серверах для scripts/import-timesheet.ts
!Табель*.xlsx

# «Асату» — отдельный git-репозиторий (github.com/alikhanneprogrammist/asatu)
asatu/

# OS
.DS_Store
